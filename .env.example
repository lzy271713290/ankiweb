# DeepSeek（推荐）
DEEPSEEK_API_KEY=

# 其他 OpenAI Chat Completions 兼容服务
CUSTOM_LLM_PROVIDER_NAME=自定义模型
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
# 多个模型用逗号分隔；可用 model-id|页面显示名 设置别名
CUSTOM_LLM_MODELS=

# 兼容旧的单模型配置（可选）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# 群机器人推送（可选）
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# 仅用于无 Key 的本地流程验收，生产环境不要开启
ENABLE_DEMO_MODEL=false

# 部署后的站点地址，用于分享卡片
NEXT_PUBLIC_APP_URL=http://localhost:5000
